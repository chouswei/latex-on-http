# Colophon render sandbox.
#
# arm64 and amd64. Everything the job needs is installed here. The container
# has no network at runtime, and tlmgr is removed so a job cannot fetch
# packages. Build-time downloads (Pandoc, d2, npm) are not runtime fetches.
#
# PIDcircuitTikZ has no CTAN package name (checked 2026-09-26). It is vendored
# from jellespijker/PIDcircuitTikZ (MIT). CircuiTikZ is the separate CTAN
# package `circuitikz`. TikZ is CTAN `pgf`. xeCJK is CTAN `xecjk`, shipped by
# Debian bookworm `texlive-lang-cjk` as xeCJK.sty (kpathsea is case-sensitive).

FROM debian:12-slim

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    DEBIAN_FRONTEND=noninteractive \
    PATH="/usr/local/bin:${PATH}" \
    PYTHONPATH=/opt/colophon \
    PUPPETEER_SKIP_DOWNLOAD=1 \
    PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=1 \
    D2_LAYOUT=dagre

RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        chromium \
        curl \
        fontconfig \
        fonts-noto-cjk \
        inkscape \
        librsvg2-bin \
        nodejs \
        npm \
        python3 \
        xz-utils \
    && apt-get install -y \
        texlive-xetex \
        texlive-lang-cjk \
        texlive-lang-chinese \
        texlive-pictures \
        texlive-science \
        texlive-latex-recommended \
        texlive-fonts-recommended \
    && rm -rf /var/lib/apt/lists/*

# Pandoc 3 is required by pandoc-ext/diagram (Figure AST). Bookworm's Pandoc
# is 2.x. Binaries are pinned; TARGETARCH selects arm64 or amd64.
ARG TARGETARCH
ARG PANDOC_VERSION=3.6.4
ARG D2_VERSION=0.7.1
RUN set -eu; \
    arch="${TARGETARCH:-$(dpkg --print-architecture)}"; \
    case "$arch" in amd64|arm64) ;; *) echo "unsupported arch $arch"; exit 1 ;; esac; \
    curl -fsSL -o /tmp/pandoc.tar.gz \
        "https://github.com/jgm/pandoc/releases/download/${PANDOC_VERSION}/pandoc-${PANDOC_VERSION}-linux-${arch}.tar.gz"; \
    tar -C /tmp -xzf /tmp/pandoc.tar.gz; \
    install -m 0755 "/tmp/pandoc-${PANDOC_VERSION}/bin/pandoc" /usr/local/bin/pandoc; \
    rm -rf /tmp/pandoc.tar.gz "/tmp/pandoc-${PANDOC_VERSION}"; \
    curl -fsSL -o /tmp/d2.tar.gz \
        "https://github.com/d2lang/d2/releases/download/v${D2_VERSION}/d2-v${D2_VERSION}-linux-${arch}.tar.gz"; \
    mkdir -p /tmp/d2; \
    tar -C /tmp/d2 -xzf /tmp/d2.tar.gz; \
    d2bin="$(find /tmp/d2 -type f -name d2 | head -n 1)"; \
    test -n "$d2bin"; \
    install -m 0755 "$d2bin" /usr/local/bin/d2; \
    rm -rf /tmp/d2 /tmp/d2.tar.gz

ARG MERMAID_CLI_VERSION=11.4.2
RUN npm install -g --prefix /opt/mermaid "@mermaid-js/mermaid-cli@${MERMAID_CLI_VERSION}" \
    && test -x /usr/bin/chromium

COPY container/puppeteer.json /etc/colophon/puppeteer.json
COPY container/xelatex-nonescape /usr/local/bin/xelatex-nonescape
COPY container/pdflatex-nonescape /usr/local/bin/pdflatex
COPY container/mmdc-wrapper /usr/local/bin/mmdc
COPY container/colophon-sandbox-render /usr/local/bin/colophon-sandbox-render
RUN chmod 0755 /usr/local/bin/xelatex-nonescape /usr/local/bin/pdflatex \
        /usr/local/bin/mmdc /usr/local/bin/colophon-sandbox-render \
    && ln -sf /usr/local/bin/xelatex-nonescape /usr/local/bin/xelatex

COPY vendor/pidcircuittikz/ /usr/local/share/texmf/tex/latex/pidcircuittikz/
# tlmgr package names, not scheme-full. Debian texlive-pictures and
# texlive-science already ship these packages; the verify step checks each
# one and fails the build if a file is missing.
#   circuitikz siunitx pgfplots chemfig mhchem tikz-3dplot tikz-feynman
#   tikz-cd forest tikz-timing bytefield pgfgantt tikz-dimline tikzscale pgf
COPY colophon/share/tex/latex/colophon-floorplan/ /usr/local/share/texmf/tex/latex/colophon-floorplan/
COPY colophon/share/tex/latex/colophon-v1/ /usr/local/share/texmf/tex/latex/colophon-v1/
COPY tests/colophon/fixtures/ /tmp/colophon-fixtures/
COPY container/check_fixture_refusals.py /tmp/colophon-check-refusals.py
COPY container/run_kind_fixtures.py /tmp/run_kind_fixtures.py
COPY vendor/diagram/diagram.lua /usr/local/share/colophon/diagram.lua
COPY colophon/share/ /usr/local/share/colophon/
COPY colophon/ /opt/colophon/colophon/
COPY container/stamp_reference_docx.py /tmp/stamp_reference_docx.py
COPY container/bake_package_set.py /tmp/colophon-bake-package-set.py

RUN set -eu; \
    apt-get update -qq; \
    apt-get install -y --no-install-recommends poppler-utils; \
    printf 'shell_escape = f\n' > /etc/texmf/texmf.d/00colophon.cnf; \
    update-texmf; \
    mktexlsr; \
    fc-cache -f; \
    kpsewhich circuitikz.sty; \
    kpsewhich siunitx.sty; \
    kpsewhich pgfplots.sty; \
    kpsewhich chemfig.sty; \
    kpsewhich mhchem.sty; \
    kpsewhich tikz-3dplot.sty; \
    kpsewhich tikz-feynman.sty; \
    kpsewhich tikzlibrarycd.code.tex; \
    kpsewhich forest.sty; \
    kpsewhich tikz-timing.sty; \
    kpsewhich bytefield.sty; \
    kpsewhich pgfgantt.sty; \
    kpsewhich tikz-dimline.sty; \
    kpsewhich tikzscale.sty; \
    kpsewhich tikz.sty; \
    kpsewhich tikzlibraryshapes.code.tex; \
    kpsewhich pgflibraryarrows.meta.code.tex; \
    kpsewhich tikzlibrarypositioning.code.tex; \
    kpsewhich tikzlibrarycalc.code.tex; \
    kpsewhich tikzlibraryautomata.code.tex; \
    kpsewhich tikzlibrarymindmap.code.tex; \
    kpsewhich colophon-floorplan.sty; \
    kpsewhich colophon-v1-preamble.tex; \
    kpsewhich xeCJK.sty; \
    kpsewhich fontspec.sty; \
    kpsewhich tikzlibrarycircuits.pid.ISO14617.code.tex; \
    python3 /tmp/colophon-bake-package-set.py; \
    rm -f /tmp/colophon-bake-package-set.py; \
    if command -v asy >/dev/null || command -v asymptote >/dev/null; then \
      echo "asymptote binary must not be installed"; \
      exit 1; \
    fi; \
    fc-list : family | grep -F "Noto Sans CJK TC"; \
    sed 's/__BODY__/繁體中文/' \
        /usr/local/share/colophon/templates/Weft/wrapper.tex > /tmp/cjk.tex; \
    xelatex -interaction=nonstopmode -halt-on-error -output-directory=/tmp /tmp/cjk.tex; \
    test -s /tmp/cjk.pdf; \
    rm -f /tmp/cjk.tex /tmp/cjk.pdf /tmp/cjk.aux /tmp/cjk.log /tmp/cjk.out; \
    cd /tmp; \
    xelatex -interaction=nonstopmode -halt-on-error -output-directory=/tmp \
      /tmp/colophon-fixtures/packages-once.tex; \
    test -s /tmp/packages-once.pdf; \
    xelatex -interaction=nonstopmode -halt-on-error -output-directory=/tmp \
      /tmp/colophon-fixtures/floorplan-two-room.tex; \
    test -s /tmp/floorplan-two-room.pdf; \
    pdftotext -raw /tmp/floorplan-two-room.pdf - | tee /tmp/floorplan.txt; \
    grep -F "2.00 m" /tmp/floorplan.txt; \
    grep -F "1.50 m" /tmp/floorplan.txt; \
    grep -F "3 m2" /tmp/floorplan.txt; \
    grep -F "2.25 m2" /tmp/floorplan.txt; \
    python3 /tmp/colophon-check-refusals.py; \
    python3 /tmp/run_kind_fixtures.py --root /tmp/colophon-fixtures/kinds; \
    rm -rf /tmp/colophon-fixtures /tmp/packages-once.* /tmp/floorplan-two-room.* \
      /tmp/colophon-tikzscale-once.tikz /tmp/colophon-tikzscale-kind.tikz \
      /tmp/colophon-check-refusals.py /tmp/run_kind_fixtures.py /tmp/floorplan.txt \
      /tmp/job.* /tmp/body.tex /tmp/input.* /tmp/out.*; \
    command -v pandoc; \
    command -v xelatex; \
    command -v d2; \
    command -v mmdc; \
    command -v inkscape; \
    python3 -c 'import colophon.sandbox_render'; \
    for lane in InstruMeasure Weft Investor; do \
        pandoc -o /tmp/reference.docx --print-default-data-file reference.docx; \
        python3 /tmp/stamp_reference_docx.py /tmp/reference.docx \
            "/usr/local/share/colophon/templates/${lane}/reference.docx" "$lane"; \
    done; \
    rm -f /tmp/reference.docx /tmp/stamp_reference_docx.py; \
    rm -f /usr/bin/tlmgr; \
    apt-get purge -y curl poppler-utils; \
    apt-get purge -y wget || true; \
    apt-get autoremove -y; \
    rm -rf /var/lib/apt/lists/* /root/.npm

RUN groupadd --gid 10001 colophon \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin colophon \
    && chown -R root:root /usr/local/share/colophon /opt/colophon

# Baked at image build. GET /version on the worker reads COLOPHON_GIT_COMMIT
# or colophon/GIT_COMMIT. Pass --build-arg COLOPHON_GIT_COMMIT=$(git rev-parse HEAD).
ARG COLOPHON_GIT_COMMIT=unknown
ENV COLOPHON_GIT_COMMIT=${COLOPHON_GIT_COMMIT}
LABEL org.opencontainers.image.source="https://github.com/chouswei/latex-on-http" \
      org.opencontainers.image.revision="${COLOPHON_GIT_COMMIT}" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later"
RUN printf '%s\n' "${COLOPHON_GIT_COMMIT}" > /opt/colophon/colophon/GIT_COMMIT \
    && chmod 0444 /opt/colophon/colophon/GIT_COMMIT

USER 10001:10001
WORKDIR /tmp
ENTRYPOINT ["colophon-sandbox-render"]
