    \xeCJKDeclareCharClass{Default}{"00AB,"00BB}%
  }{}%
}
\newcommand{\sysmlguillemets}[1]{«#1»}
%% An active tilde in a port label marks a conjugated port.
\begingroup
\catcode`\~=\active
