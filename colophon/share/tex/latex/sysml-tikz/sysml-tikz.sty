\newcommand{\sysmllabel}[4][]{%
  \node[sysml #1] at (#2,#3) {#4};%
}

%% Direction glyph inside the square. Tips sit 1.15 mm from the centre.
%% The square extends 1.6 mm, so the margin to each face is 0.45 mm.
%% A line stops on that face. An arrowhead tip touches the face and the head stays outside the square.
%% #1 side, #2 direction (in|out|inout|empty), #3 cx, #4 cy.
%% y grows downward. `in` points into the part, `out` points out of it.
%% Empty direction draws nothing.
%% Expand #2. Callers pass the effective direction as a macro, and
%% \ifx does not expand, so a plain \def would match no glyph.
\newcommand{\sysml@portdir}[4]{%
  \edef\sysml@side{#1}%
  \edef\sysml@dir{#2}%
  \def\sysml@in{in}%
  \def\sysml@out{out}%
  \def\sysml@inout{inout}%
  \def\sysml@east{EAST}\def\sysml@west{WEST}%
  \def\sysml@north{NORTH}\def\sysml@south{SOUTH}%
  \ifx\sysml@side\sysml@north
    \ifx\sysml@dir\sysml@in
      \draw[line width=0.2pt,-{Triangle[length=0.8mm,width=0.55mm]}] ($(#3,#4)+(0,-1.15)$) -- ($(#3,#4)+(0,1.15)$);%
    \else\ifx\sysml@dir\sysml@out
      \draw[line width=0.2pt,-{Triangle[length=0.8mm,width=0.55mm]}] ($(#3,#4)+(0,1.15)$) -- ($(#3,#4)+(0,-1.15)$);%
    \else\ifx\sysml@dir\sysml@inout
      \draw[line width=0.2pt,{Triangle[length=0.7mm,width=0.5mm]}-{Triangle[length=0.7mm,width=0.5mm]}] ($(#3,#4)+(0,-1.15)$) -- ($(#3,#4)+(0,1.15)$);%
    \fi\fi\fi
  \else\ifx\sysml@side\sysml@south
    \ifx\sysml@dir\sysml@in
      \draw[line width=0.2pt,-{Triangle[length=0.8mm,width=0.55mm]}] ($(#3,#4)+(0,1.15)$) -- ($(#3,#4)+(0,-1.15)$);%
    \else\ifx\sysml@dir\sysml@out
      \draw[line width=0.2pt,-{Triangle[length=0.8mm,width=0.55mm]}] ($(#3,#4)+(0,-1.15)$) -- ($(#3,#4)+(0,1.15)$);%
    \else\ifx\sysml@dir\sysml@inout
      \draw[line width=0.2pt,{Triangle[length=0.7mm,width=0.5mm]}-{Triangle[length=0.7mm,width=0.5mm]}] ($(#3,#4)+(0,-1.15)$) -- ($(#3,#4)+(0,1.15)$);%
    \fi\fi\fi
  \else\ifx\sysml@side\sysml@west
    \ifx\sysml@dir\sysml@in
      \draw[line width=0.2pt,-{Triangle[length=0.8mm,width=0.55mm]}] ($(#3,#4)+(-1.15,0)$) -- ($(#3,#4)+(1.15,0)$);%
    \else\ifx\sysml@dir\sysml@out
      \draw[line width=0.2pt,-{Triangle[length=0.8mm,width=0.55mm]}] ($(#3,#4)+(1.15,0)$) -- ($(#3,#4)+(-1.15,0)$);%
    \else\ifx\sysml@dir\sysml@inout
      \draw[line width=0.2pt,{Triangle[length=0.7mm,width=0.5mm]}-{Triangle[length=0.7mm,width=0.5mm]}] ($(#3,#4)+(-1.15,0)$) -- ($(#3,#4)+(1.15,0)$);%
    \fi\fi\fi
  \else\ifx\sysml@side\sysml@east
    \ifx\sysml@dir\sysml@in
      \draw[line width=0.2pt,-{Triangle[length=0.8mm,width=0.55mm]}] ($(#3,#4)+(1.15,0)$) -- ($(#3,#4)+(-1.15,0)$);%
    \else\ifx\sysml@dir\sysml@out
      \draw[line width=0.2pt,-{Triangle[length=0.8mm,width=0.55mm]}] ($(#3,#4)+(-1.15,0)$) -- ($(#3,#4)+(1.15,0)$);%
    \else\ifx\sysml@dir\sysml@inout
      \draw[line width=0.2pt,{Triangle[length=0.7mm,width=0.5mm]}-{Triangle[length=0.7mm,width=0.5mm]}] ($(#3,#4)+(-1.15,0)$) -- ($(#3,#4)+(1.15,0)$);%
    \fi\fi\fi
  \fi\fi\fi\fi
}

%% Optional keys, then id, centre, side, label point, label, direction.
%% conjugated, or a leading tilde in the label, flips in and out and
%% shows a tilde. The recorded direction is the effective one.
\newcommand{\sysmlport}[9][]{%
  \pgfkeys{/sysml/port, conjugated=false, #1}%
  \sysml@absorbtilde{#8}%
  \sysml@effectivedir{#9}%
  \sysml@rememberport{#2}{#3}{#4}{#5}{\sysml@effdir}%
  \draw[sysml port] ($(#3,#4)+(-1.6,-1.6)$) rectangle ($(#3,#4)+(1.6,1.6)$);%
  \sysml@portdir{#5}{\sysml@effdir}{#3}{#4}%
  \node[sysml port label] at (#6,#7) {\sysml@shownlabel};%
}
\newcommand{\sysml@absorbtilde}[1]{%
  \gdef\sysml@rest{}%
  \if\relax\detokenize{#1}\relax
  \else
    \sysml@splittilde#1\sysml@nil
  \fi
}
\def\sysml@splittilde#1#2\sysml@nil{%
  \def\sysml@one{#1}%
  \ifx\sysml@one\sysml@acttilde
    \global\sysml@conjugatedtrue
    \gdef\sysml@rest{#2}%
  \else
    \expandafter\ifx\sysml@one\textasciitilde
      \global\sysml@conjugatedtrue
      \gdef\sysml@rest{#2}%
    \else
      \gdef\sysml@rest{#1#2}%
    \fi
  \fi
}
\newcommand{\sysml@shownlabel}{%
  \ifsysml@conjugated
    \textasciitilde\sysml@rest
  \else
    \sysml@rest
  \fi
}
\newcommand{\sysml@effectivedir}[1]{%
  \def\sysml@effdir{#1}%
  \def\sysml@inword{in}%
  \def\sysml@outword{out}%
  \ifsysml@conjugated
    \ifx\sysml@effdir\sysml@inword
      \def\sysml@effdir{out}%
    \else\ifx\sysml@effdir\sysml@outword
      \def\sysml@effdir{in}%
    \fi\fi
  \fi
}

%% Outer edge is 1.6 mm out from the centre, on the named side.
%% y grows downward, so NORTH is the smaller y.
\newcommand{\sysml@rememberport}[5]{%
  \def\sysml@id{#1}%
  \def\sysml@side{#4}%
  \def\sysml@dx{0}\def\sysml@dy{0}%
  \def\sysml@east{EAST}\def\sysml@west{WEST}%
  \def\sysml@north{NORTH}\def\sysml@south{SOUTH}%
  \ifx\sysml@side\sysml@east\def\sysml@dx{1.6}\fi
  \ifx\sysml@side\sysml@west\def\sysml@dx{-1.6}\fi
  \ifx\sysml@side\sysml@north\def\sysml@dy{-1.6}\fi
  \ifx\sysml@side\sysml@south\def\sysml@dy{1.6}\fi
  \pgfpointadd{\pgfpointxy{#2}{#3}}{\pgfpointxy{\sysml@dx}{\sysml@dy}}%
  \expandafter\xdef\csname sysml@pex@\sysml@id\endcsname{\the\pgf@x}%
  \expandafter\xdef\csname sysml@pey@\sysml@id\endcsname{\the\pgf@y}%
  \expandafter\xdef\csname sysml@pdir@\sysml@id\endcsname{#5}%
}

\newcommand{\sysml@lookupdir}[2]{%
  \edef\sysml@dirkey{sysml@pdir@#1}%
  \ifcsname\sysml@dirkey\endcsname
    \expandafter\let\expandafter#2\csname\sysml@dirkey\endcsname
  \else
    \let#2\@empty
  \fi
}

%% Canvas millimetres, same \pgfpointxy the port edge uses.
\newcommand{\sysml@setpt}[4]{%
  \pgfpointxy{#1}{#2}%
  \edef#3{\the\pgf@x}%
  \edef#4{\the\pgf@y}%
}
\newdimen\sysml@da
\newdimen\sysml@db
\newcommand{\sysml@absdiff}[3]{%
  \sysml@da=#1\relax
  \sysml@db=#2\relax
  \advance\sysml@da by -\sysml@db
  \ifdim\sysml@da<0pt
    \sysml@da=-\sysml@da
  \fi
  \edef#3{\the\sysml@da}%
}
\newcommand{\sysml@mandist}[5]{%
  \sysml@absdiff{#1}{#3}\sysml@adx
  \sysml@absdiff{#2}{#4}\sysml@ady
  \sysml@da=\sysml@adx\relax
  \advance\sysml@da by \sysml@ady\relax
  \edef#5{\the\sysml@da}%
}
\def\sysml@findparen#1(#2\sysml@endscan{%
  \sysml@scanone(#2\sysml@endscan
}
\def\sysml@stopmark{\sysml@stopmark}
\def\sysml@scanone(#1,#2)#3\sysml@endscan{%
  \def\sysml@nx{#1}%
  \ifx\sysml@nx\sysml@stopmark
  \else
    \sysml@setpt{#1}{#2}\sysml@xhere\sysml@yhere
    \ifsysml@gotend
    \else
      \let\sysml@xstart\sysml@xhere
      \let\sysml@ystart\sysml@yhere
      \sysml@gotendtrue
    \fi
    \let\sysml@xend\sysml@xhere
    \let\sysml@yend\sysml@yhere
    \sysml@findparen#3\sysml@endscan
  \fi
}
\newcommand{\sysml@capturepath}[1]{%
  \gdef\sysml@xstart{0pt}%
  \gdef\sysml@ystart{0pt}%
  \gdef\sysml@xend{0pt}%
  \gdef\sysml@yend{0pt}%
  \global\sysml@gotendfalse
  \sysml@findparen#1(\sysml@stopmark,\sysml@stopmark)\sysml@endscan
}

%% The tip of a line arrow sits on the path end the caller placed on
%% the port face. The head extends back along the path, outside the square.
%% Which end is the `to` port is the nearer recorded outer-edge point.
\newcommand{\sysml@loadends}{%
  \pgfkeysgetvalue{/sysml/connection/from}{\sysml@fromid}%
  \pgfkeysgetvalue{/sysml/connection/to}{\sysml@toid}%
}
\newcommand{\sysml@warnends}{%
  \sysml@lookupdir{\sysml@fromid}{\sysml@fromdir}%
  \sysml@lookupdir{\sysml@toid}{\sysml@todir}%
  \def\sysml@inword{in}%
  \def\sysml@outword{out}%
  \def\sysml@inoutword{inout}%
  \ifx\sysml@fromdir\@empty\else
    \ifx\sysml@todir\@empty\else
      \ifx\sysml@fromdir\sysml@inoutword\else
        \ifx\sysml@todir\sysml@inoutword\else
          \ifx\sysml@fromdir\sysml@todir
            \PackageWarning{sysml-tikz}{Port directions \sysml@fromdir\space and \sysml@todir\space do not meet (out must meet in; inout meets any). The line arrowhead is not changed}%
          \fi
        \fi
      \fi
    \fi
  \fi
}
\newcommand{\sysml@pathendisto}[1]{%
  \sysml@alongpathtrue
  \sysml@capturepath{#1}%
  \ifsysml@gotend
    \edef\sysml@xkey{sysml@pex@\sysml@toid}%
    \edef\sysml@ykey{sysml@pey@\sysml@toid}%
    \ifcsname\sysml@xkey\endcsname
      \expandafter\let\expandafter\sysml@tx\csname\sysml@xkey\endcsname
      \expandafter\let\expandafter\sysml@ty\csname\sysml@ykey\endcsname
      \sysml@mandist\sysml@xstart\sysml@ystart\sysml@tx\sysml@ty\sysml@dstart
      \sysml@mandist\sysml@xend\sysml@yend\sysml@tx\sysml@ty\sysml@dend
      \ifdim\sysml@dstart<\sysml@dend
        \sysml@alongpathfalse
      \fi
    \fi
  \fi
}
\newcommand{\sysml@setpointatto}{%
  \pgfkeysgetvalue{/sysml/connection/flow}{\sysml@flow}%
  \edef\sysml@flowtest{\sysml@flow}%
  \def\sysml@revword{reverse}%
  \ifx\sysml@flowtest\sysml@revword
    \sysml@pointattofalse
  \else
    \sysml@pointattotrue
  \fi
}
\newcommand{\sysml@choosearrow}{%
  \ifsysml@alongpath
    \ifsysml@pointatto\sysml@usefwdtrue\else\sysml@usefwdfalse\fi
  \else
    \ifsysml@pointatto\sysml@usefwdfalse\else\sysml@usefwdtrue\fi
  \fi
}
\newcommand{\sysml@markstyle}{%
  \ifsysml@usefwd
    \def\sysml@markname{sysml flow mark forward}%
  \else
    \def\sysml@markname{sysml flow mark reverse}%
  \fi
}
\newcommand{\sysml@headstyle}[1]{%
  \ifsysml@alongpath
    \edef\sysml@drawstyle{#1 end}%
  \else
    \edef\sysml@drawstyle{#1 start}%
  \fi
}
\newcommand{\sysml@drawitem}[3]{%
  \pgfkeysgetvalue{/sysml/connection/item}{\sysml@item}%
  \ifx\sysml@item\@empty
    \draw[#1] #2;%
  \else
    \draw[#1] #2 node[sysml edge label, pos=#3] {\sysml@item};%
  \fi
}
\newcommand{\sysml@drawfixed}[4]{%
  \draw[#1] #2 node[sysml edge label, pos=#3] {#4};%
}
\newcommand{\sysml@resetline}[1]{%
  \pgfkeys{/sysml/connection, from={}, to={}, directed=false, flow={}, item={}, at=end, keyword=false, #1}%
  \sysml@loadends
  \sysml@warnends
}

%% #1 keys. #2 name, not drawn (names stay off the edge). #3 path.
%% A connection is a plain solid line. directed draws an open stick
%% at the to end. flow=forward|reverse draws a filled mid-line triangle.
\newcommand{\sysmlconnection}[3][]{%
  \sysml@resetline{#1}%
  \def\sysml@edgename{#2}%
  \pgfkeysgetvalue{/sysml/connection/flow}{\sysml@flow}%
  \ifx\sysml@flow\@empty
    \ifsysml@directed
      \sysml@pathendisto{#3}%
      \sysml@headstyle{sysml directed}%
    \else
      \def\sysml@drawstyle{sysml connection}%
    \fi
    \expandafter\sysml@drawitem\expandafter{\sysml@drawstyle}{#3}{0.42}%
  \else
    \sysml@pathendisto{#3}%
    \sysml@setpointatto
    \sysml@choosearrow
    \sysml@markstyle
    \ifsysml@directed
      \sysml@headstyle{sysml directed}%
      \edef\sysml@drawstyle{\sysml@drawstyle, \sysml@markname}%
    \else
      \edef\sysml@drawstyle{sysml connection, \sysml@markname}%
    \fi
    \expandafter\sysml@drawitem\expandafter{\sysml@drawstyle}{#3}{0.18}%
  \fi
}
%% Solid filled triangle from from toward to. at=mid keeps it on the line.
\newcommand{\sysmlflow}[3][]{%
  \sysml@resetline{#1}%
  \def\sysml@edgename{#2}%
  \sysml@pointattotrue
  \pgfkeysgetvalue{/sysml/connection/at}{\sysml@at}%
  \edef\sysml@attest{\sysml@at}%
  \def\sysml@midword{mid}%
  \sysml@pathendisto{#3}%
  \ifx\sysml@attest\sysml@midword
    \sysml@choosearrow
    \sysml@markstyle
    \edef\sysml@drawstyle{sysml connection, \sysml@markname}%
    \expandafter\sysml@drawitem\expandafter{\sysml@drawstyle}{#3}{0.18}%
  \else
    \sysml@headstyle{sysml flow}%
    \expandafter\sysml@drawitem\expandafter{\sysml@drawstyle}{#3}{0.42}%
  \fi
}
%% Dashed line, filled triangle at the to end.
\newcommand{\sysmlsuccessionflow}[3][]{%
  \sysml@resetline{#1}%
  \def\sysml@edgename{#2}%
  \sysml@pathendisto{#3}%
  \sysml@headstyle{sysml succession}%
  \expandafter\sysml@drawitem\expandafter{\sysml@drawstyle}{#3}{0.42}%
}
%% Solid line, hollow triangle at the to end.
\newcommand{\sysmlmessage}[3][]{%
  \sysml@resetline{#1}%
  \def\sysml@edgename{#2}%
  \sysml@pathendisto{#3}%
  \sysml@headstyle{sysml message}%
  \expandafter\sysml@drawitem\expandafter{\sysml@drawstyle}{#3}{0.42}%
}
%% Solid line, equals sign at the midpoint, no arrowhead.
\newcommand{\sysmlbinding}[3][]{%
  \sysml@resetline{#1}%
  \def\sysml@edgename{#2}%
  \draw[sysml connection] #3 node[sysml edge label, pos=0.5] {=};%
}
%% Solid line, optional «interface», no arrowhead.
\newcommand{\sysmlinterface}[3][]{%
  \pgfkeys{/sysml/connection, from={}, to={}, directed=false, flow={}, item={}, at=end, keyword=true, #1}%
  \def\sysml@edgename{#2}%
  \sysml@loadends
  \sysml@warnends
  \ifsysml@showkeyword
    \draw[sysml connection] #3 node[sysml edge label, pos=0.5] {\sysmlguillemets{interface}};%
  \else
    \draw[sysml connection] #3;%
  \fi
}
%% Solid line, open stick at the to end (same head as directed), «allocate».
\newcommand{\sysmlallocation}[3][]{%
  \sysml@resetline{#1}%
  \def\sysml@edgename{#2}%
  \sysml@pathendisto{#3}%
  \sysml@headstyle{sysml allocate}%
  \expandafter\sysml@drawfixed\expandafter{\sysml@drawstyle}{#3}{0.5}{\sysmlguillemets{allocate}}%
}

%% Collapse count, bottom-right inside the owner. Not a header line.
\newcommand{\sysmlbadge}[3]{%
  \node[sysml badge] at (#1,#2) {#3};%
}

\newcommand{\sysmlconnectionlegend}[1]{%
  \par\noindent{\fontsize{7}{9}\selectfont Connections: #1\par}%
}

\newcommand{\sysmlnotation}{%
  \par\noindent{\fontsize{7}{9}\selectfont n hidden = collapsed parts (not SysML notation)\par}%
}

\newcommand{\sysmlstamp}{%
  \par\noindent{\fontsize{7}{9}\selectfont
    View \texttt{\pgfkeysvalueof{/sysml/view}}\quad
    rev \texttt{\pgfkeysvalueof{/sysml/revision}}\quad
    overrides \texttt{\pgfkeysvalueof{/sysml/overrides}}\quad
    depth \texttt{\pgfkeysvalueof{/sysml/depth}}\par}%
}

\newcommand{\sysml@depthcutmessage}{%
  \begingroup
  \pgfkeysgetvalue{/sysml/depth cut}{\sysml@cut}%
  \ifx\sysml@cut\@empty
    Suggested depth cut: lower the document depth.%
  \else
    Suggested depth cut: \sysml@cut.%
  \fi
  \endgroup
}

\newsavebox{\sysmlpicbox}
\newsavebox{\sysmlcapbox}

\newcommand{\sysml@caption}{%
  \ifsysmlconnectionslist
    \pgfkeysgetvalue{/sysml/legend}{\sysml@leg}%
    \ifx\sysml@leg\@empty\else
      {\fontsize{7}{9}\selectfont Connections: \sysml@leg\par}%
    \fi
  \fi
  {\fontsize{7}{9}\selectfont
    View \texttt{\pgfkeysvalueof{/sysml/view}}\quad
    rev \texttt{\pgfkeysvalueof{/sysml/revision}}\quad
    overrides \texttt{\pgfkeysvalueof{/sysml/overrides}}\quad
    depth \texttt{\pgfkeysvalueof{/sysml/depth}}\quad
    type \texttt{\sysml@body}\,pt\par}%
}

\newcommand{\sysml@warntext}{%
  \par\noindent{\fontsize{7}{9}\selectfont
    Warning: this view does not fit the page at \sysml@body\,pt.
    The drawing was not scaled down.
    \sysml@depthcutmessage
    Each expanded part continues on its own page.\par}%
}

\newcommand{\sysml@footnote}{%
  \ifsysmlcollapsenote
    \par\vspace{2mm}%
    {\fontsize{7}{9}\selectfont n hidden = collapsed parts (not SysML notation)\par}%
  \fi
}

%% Caption is a wrapped paragraph inside the text block, then a 3 mm
%% gap, then the drawing. A picture with y down has a large TeX depth;
%% raising it by that depth keeps the following footnote below the frame.
%% Nothing is clipped. A fit warning is printed only when the generator
%% asks for one, which is the drill-down overview.
\newcommand{\sysml@typeset}{%
  \ifsysmlfitwarn
    \pgfkeysgetvalue{/sysml/depth cut}{\sysml@cut}%
    \ifx\sysml@cut\@empty
      \typeout{SYSMLDEPTHCUT lower the document depth}%
    \else
      \typeout{SYSMLDEPTHCUT \sysml@cut}%
    \fi
    \PackageWarning{sysml-tikz}{View does not fit the page at \sysml@body pt. Text was not shrunk. \sysml@depthcutmessage}%
  \fi
  \setbox\sysmlcapbox=\vbox{%
    \hsize=\textwidth
    \raggedright
    \noindent\sysml@caption
    \ifsysmlfitwarn\sysml@warntext\fi
  }%
  \noindent\usebox{\sysmlcapbox}\par
  \vspace{3mm}%
  \noindent\makebox[\textwidth][c]{\raisebox{\dp\sysmlpicbox}{\usebox{\sysmlpicbox}}}\par
  \sysml@footnote
}

%% Body is a sysmlcanvas (or other horizontal material) plus nothing else.
%% lrbox is begun with \begin so it restores \@currenvir before the body.
\newenvironment{sysmlfigure}[1][]{%
  \sysmlset{#1}%
  \begin{lrbox}{\sysmlpicbox}%
}{%
  \end{lrbox}%
  \sysml@typeset
}

%% ELK y-down millimetre coordinates. No placement.
\newenvironment{sysmlcanvas}{%
  \tikzpicture[x=1mm,y=-1mm]%
}{%
  \endtikzpicture
}
