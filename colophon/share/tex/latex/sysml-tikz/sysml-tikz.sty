%% Direction glyph inside the square. Tips sit 1.15 mm from the centre.
%% The square extends 1.6 mm, so the margin to each face is 0.45 mm.
%% A line stops on that face. An arrowhead tip touches the face and the head stays outside the square.
%% #1 side, #2 direction (in|out|inout|empty), #3 cx, #4 cy.
%% y grows downward. `in` points into the part, `out` points out of it.
%% Empty direction draws nothing.
%% Expand #2. Callers pass the effective direction as a macro, and
%% \ifx does not expand, so a plain \def would match no glyph.
\newcommand{\sysml@portdir}[4]{%
  \edef\sysml@side{#1}%
  \edef\sysml@dir{#2}%
  \def\sysml@in{in}%
  \def\sysml@out{out}%
  \def\sysml@inout{inout}%
  \def\sysml@east{EAST}\def\sysml@west{WEST}%
  \def\sysml@north{NORTH}\def\sysml@south{SOUTH}%
  \ifx\sysml@side\sysml@north
    \ifx\sysml@dir\sysml@in
      \draw[line width=0.2pt,-{Triangle[length=0.8mm,width=0.55mm]}] ($(#3,#4)+(0,-1.15)$) -- ($(#3,#4)+(0,1.15)$);%
    \else\ifx\sysml@dir\sysml@out
      \draw[line width=0.2pt,-{Triangle[length=0.8mm,width=0.55mm]}] ($(#3,#4)+(0,1.15)$) -- ($(#3,#4)+(0,-1.15)$);%
    \else\ifx\sysml@dir\sysml@inout
      \draw[line width=0.2pt,{Triangle[length=0.7mm,width=0.5mm]}-{Triangle[length=0.7mm,width=0.5mm]}] ($(#3,#4)+(0,-1.15)$) -- ($(#3,#4)+(0,1.15)$);%
    \fi\fi\fi
  \else\ifx\sysml@side\sysml@south
    \ifx\sysml@dir\sysml@in
      \draw[line width=0.2pt,-{Triangle[length=0.8mm,width=0.55mm]}] ($(#3,#4)+(0,1.15)$) -- ($(#3,#4)+(0,-1.15)$);%
    \else\ifx\sysml@dir\sysml@out
      \draw[line width=0.2pt,-{Triangle[length=0.8mm,width=0.55mm]}] ($(#3,#4)+(0,-1.15)$) -- ($(#3,#4)+(0,1.15)$);%
    \else\ifx\sysml@dir\sysml@inout
      \draw[line width=0.2pt,{Triangle[length=0.7mm,width=0.5mm]}-{Triangle[length=0.7mm,width=0.5mm]}] ($(#3,#4)+(0,-1.15)$) -- ($(#3,#4)+(0,1.15)$);%
    \fi\fi\fi
  \else\ifx\sysml@side\sysml@west
    \ifx\sysml@dir\sysml@in
      \draw[line width=0.2pt,-{Triangle[length=0.8mm,width=0.55mm]}] ($(#3,#4)+(-1.15,0)$) -- ($(#3,#4)+(1.15,0)$);%
    \else\ifx\sysml@dir\sysml@out
      \draw[line width=0.2pt,-{Triangle[length=0.8mm,width=0.55mm]}] ($(#3,#4)+(1.15,0)$) -- ($(#3,#4)+(-1.15,0)$);%
    \else\ifx\sysml@dir\sysml@inout
      \draw[line width=0.2pt,{Triangle[length=0.7mm,width=0.5mm]}-{Triangle[length=0.7mm,width=0.5mm]}] ($(#3,#4)+(-1.15,0)$) -- ($(#3,#4)+(1.15,0)$);%
    \fi\fi\fi
  \else\ifx\sysml@side\sysml@east
    \ifx\sysml@dir\sysml@in
      \draw[line width=0.2pt,-{Triangle[length=0.8mm,width=0.55mm]}] ($(#3,#4)+(1.15,0)$) -- ($(#3,#4)+(-1.15,0)$);%
    \else\ifx\sysml@dir\sysml@out
      \draw[line width=0.2pt,-{Triangle[length=0.8mm,width=0.55mm]}] ($(#3,#4)+(-1.15,0)$) -- ($(#3,#4)+(1.15,0)$);%
    \else\ifx\sysml@dir\sysml@inout
      \draw[line width=0.2pt,{Triangle[length=0.7mm,width=0.5mm]}-{Triangle[length=0.7mm,width=0.5mm]}] ($(#3,#4)+(-1.15,0)$) -- ($(#3,#4)+(1.15,0)$);%
    \fi\fi\fi
  \fi\fi\fi\fi
}

%% Optional keys, then id, centre, side, label point, label, direction.
%% conjugated, or a leading tilde in the label, flips in and out and
%% shows a tilde. The recorded direction is the effective one.
\newcommand{\sysmlport}[9][]{%
  \pgfkeys{/sysml/port, conjugated=false, #1}%
  \sysml@absorbtilde{#8}%
  \sysml@effectivedir{#9}%
  \sysml@rememberport{#2}{#3}{#4}{#5}{\sysml@effdir}%
  \draw[sysml port] ($(#3,#4)+(-1.6,-1.6)$) rectangle ($(#3,#4)+(1.6,1.6)$);%
  \sysml@recordxy{#3-1.6}{#4-1.6}{3.2}{3.2}{port}%
  \sysml@portdir{#5}{\sysml@effdir}{#3}{#4}%
  \node[sysml port label] (sysml@plab) at (#6,#7) {\sysml@shownlabel};%
  \sysml@pushnode{plab}{sysml@plab}%
}
\newcommand{\sysml@absorbtilde}[1]{%
  \gdef\sysml@rest{}%
  \if\relax\detokenize{#1}\relax
  \else
    \sysml@splittilde#1\sysml@nil
  \fi
}
\def\sysml@splittilde#1#2\sysml@nil{%
  \def\sysml@one{#1}%
  \ifx\sysml@one\sysml@acttilde
    \global\sysml@conjugatedtrue
    \gdef\sysml@rest{#2}%
  \else
    \expandafter\ifx\sysml@one\textasciitilde
      \global\sysml@conjugatedtrue
      \gdef\sysml@rest{#2}%
    \else
      \gdef\sysml@rest{#1#2}%
    \fi
  \fi
}
\newcommand{\sysml@shownlabel}{%
  \ifsysml@conjugated
    \textasciitilde\sysml@rest
  \else
    \sysml@rest
  \fi
}
\newcommand{\sysml@effectivedir}[1]{%
  \def\sysml@effdir{#1}%
  \def\sysml@inword{in}%
  \def\sysml@outword{out}%
  \ifsysml@conjugated
    \ifx\sysml@effdir\sysml@inword
      \def\sysml@effdir{out}%
    \else\ifx\sysml@effdir\sysml@outword
      \def\sysml@effdir{in}%
    \fi\fi
  \fi
}

%% Outer edge is 1.6 mm out from the centre, on the named side.
%% y grows downward, so NORTH is the smaller y.
\newcommand{\sysml@rememberport}[5]{%
  \def\sysml@id{#1}%
  \def\sysml@side{#4}%
  \def\sysml@dx{0}\def\sysml@dy{0}%
  \def\sysml@east{EAST}\def\sysml@west{WEST}%
  \def\sysml@north{NORTH}\def\sysml@south{SOUTH}%
  \ifx\sysml@side\sysml@east\def\sysml@dx{1.6}\fi
  \ifx\sysml@side\sysml@west\def\sysml@dx{-1.6}\fi
  \ifx\sysml@side\sysml@north\def\sysml@dy{-1.6}\fi
  \ifx\sysml@side\sysml@south\def\sysml@dy{1.6}\fi
  \pgfpointadd{\pgfpointxy{#2}{#3}}{\pgfpointxy{\sysml@dx}{\sysml@dy}}%
  \expandafter\xdef\csname sysml@pex@\sysml@id\endcsname{\the\pgf@x}%
  \expandafter\xdef\csname sysml@pey@\sysml@id\endcsname{\the\pgf@y}%
  \expandafter\xdef\csname sysml@pdir@\sysml@id\endcsname{#5}%
}

\newcommand{\sysml@lookupdir}[2]{%
  \edef\sysml@dirkey{sysml@pdir@#1}%
  \ifcsname\sysml@dirkey\endcsname
    \expandafter\let\expandafter#2\csname\sysml@dirkey\endcsname
  \else
    \let#2\@empty
  \fi
}

%% Canvas millimetres, same \pgfpointxy the port edge uses.
\newcommand{\sysml@setpt}[4]{%
  \pgfpointxy{#1}{#2}%
  \edef#3{\the\pgf@x}%
  \edef#4{\the\pgf@y}%
}
\newdimen\sysml@da
\newdimen\sysml@db
\newcommand{\sysml@absdiff}[3]{%
  \sysml@da=#1\relax
  \sysml@db=#2\relax
  \advance\sysml@da by -\sysml@db
  \ifdim\sysml@da<0pt
    \sysml@da=-\sysml@da
  \fi
  \edef#3{\the\sysml@da}%
}
\newcommand{\sysml@mandist}[5]{%
  \sysml@absdiff{#1}{#3}\sysml@adx
  \sysml@absdiff{#2}{#4}\sysml@ady
  \sysml@da=\sysml@adx\relax
  \advance\sysml@da by \sysml@ady\relax
  \edef#5{\the\sysml@da}%
}
\def\sysml@findparen#1(#2\sysml@endscan{%
  \sysml@scanone(#2\sysml@endscan
}
\def\sysml@stopmark{\sysml@stopmark}
\def\sysml@scanone(#1,#2)#3\sysml@endscan{%
  \def\sysml@nx{#1}%
  \ifx\sysml@nx\sysml@stopmark
  \else
    \sysml@setpt{#1}{#2}\sysml@xhere\sysml@yhere
    \pgfpointtransformed{\pgfpointxy{#1}{#2}}%
    \edef\sysml@axhere{\the\pgf@x}%
    \edef\sysml@ayhere{\the\pgf@y}%
    \global\advance\sysml@npt by 1\relax
    \expandafter\xdef\csname sysml@ax@\the\sysml@npt\endcsname{\sysml@axhere}%
    \expandafter\xdef\csname sysml@ay@\the\sysml@npt\endcsname{\sysml@ayhere}%
    \ifsysml@gotend
    \else
      \let\sysml@xstart\sysml@xhere
      \let\sysml@ystart\sysml@yhere
      \sysml@gotendtrue
    \fi
    \let\sysml@xend\sysml@xhere
    \let\sysml@yend\sysml@yhere
    \sysml@findparen#3\sysml@endscan
  \fi
}
\newcommand{\sysml@capturepath}[1]{%
  \gdef\sysml@xstart{0pt}%
  \gdef\sysml@ystart{0pt}%
  \gdef\sysml@xend{0pt}%
  \gdef\sysml@yend{0pt}%
  \global\sysml@npt=0\relax
  \global\sysml@gotendfalse
  \sysml@findparen#1(\sysml@stopmark,\sysml@stopmark)\sysml@endscan
  \sysml@measurepath
}

%% The tip of a line arrow sits on the path end the caller placed on
%% the port face. The head extends back along the path, outside the square.
%% Which end is the `to` port is the nearer recorded outer-edge point.
\newcommand{\sysml@loadends}{%
  \pgfkeysgetvalue{/sysml/connection/from}{\sysml@fromid}%
  \pgfkeysgetvalue{/sysml/connection/to}{\sysml@toid}%
}
\newcommand{\sysml@warnends}{%
  \sysml@lookupdir{\sysml@fromid}{\sysml@fromdir}%
  \sysml@lookupdir{\sysml@toid}{\sysml@todir}%
  \def\sysml@inword{in}%
  \def\sysml@outword{out}%
  \def\sysml@inoutword{inout}%
  \ifx\sysml@fromdir\@empty\else
    \ifx\sysml@todir\@empty\else
      \ifx\sysml@fromdir\sysml@inoutword\else
        \ifx\sysml@todir\sysml@inoutword\else
          \ifx\sysml@fromdir\sysml@todir
            \PackageWarning{sysml-tikz}{Port directions \sysml@fromdir\space and \sysml@todir\space do not meet (out must meet in; inout meets any). The line arrowhead is not changed}%
          \fi
        \fi
      \fi
    \fi
  \fi
}
\newcommand{\sysml@pathendisto}[1]{%
  \sysml@alongpathtrue
  \sysml@capturepath{#1}%
  \ifsysml@gotend
    \edef\sysml@xkey{sysml@pex@\sysml@toid}%
    \edef\sysml@ykey{sysml@pey@\sysml@toid}%
    \ifcsname\sysml@xkey\endcsname
      \expandafter\let\expandafter\sysml@tx\csname\sysml@xkey\endcsname
      \expandafter\let\expandafter\sysml@ty\csname\sysml@ykey\endcsname
      \sysml@mandist\sysml@xstart\sysml@ystart\sysml@tx\sysml@ty\sysml@dstart
      \sysml@mandist\sysml@xend\sysml@yend\sysml@tx\sysml@ty\sysml@dend
      \ifdim\sysml@dstart<\sysml@dend
        \sysml@alongpathfalse
      \fi
    \fi
  \fi
}
\newcommand{\sysml@setpointatto}{%
  \pgfkeysgetvalue{/sysml/connection/flow}{\sysml@flow}%
  \edef\sysml@flowtest{\sysml@flow}%
  \def\sysml@revword{reverse}%
  \ifx\sysml@flowtest\sysml@revword
    \sysml@pointattofalse
  \else
    \sysml@pointattotrue
  \fi
}
\newcommand{\sysml@choosearrow}{%
  \ifsysml@alongpath
    \ifsysml@pointatto\sysml@usefwdtrue\else\sysml@usefwdfalse\fi
  \else
    \ifsysml@pointatto\sysml@usefwdfalse\else\sysml@usefwdtrue\fi
  \fi
}
\newcommand{\sysml@headstyle}[1]{%
  \ifsysml@alongpath
    \edef\sysml@drawstyle{#1 end}%
  \else
    \edef\sysml@drawstyle{#1 start}%
  \fi
}
%% TikZ node pos= is the fraction of the last segment only. A mid
%% marker has to sit at a fraction of the whole path. decorations.markings
%% measures that arc length. The mark is drawn on a copy of the path
%% with no arrow tip, so an end head does not shorten the length.
%% The copy is not stroked. End heads stay on the stroked path.
\newcommand{\sysml@addmark}[2]{%
  \ifx\sysml@marks\@empty
    \def\sysml@marks{mark=at position #1 with {#2}}%
  \else
    \expandafter\def\expandafter\sysml@marks\expandafter{%
      \sysml@marks, mark=at position #1 with {#2}}%
  \fi
}
\newcommand{\sysml@trace}[1]{%
  \ifsysml@marktrace
    \begingroup
      \pgfpointtransformed{\pgfpointorigin}%
      \edef\sysml@mx{\the\pgf@x}%
      \edef\sysml@my{\the\pgf@y}%
      \pgfmathsetmacro{\sysml@mang}{\pgfdecoratedangle}%
      \typeout{SYSMLMARK #1 x=\sysml@mx\space y=\sysml@my\space ang=\sysml@mang}%
    \endgroup
  \fi
}
%% 0.6 mm clears a 0.45 pt stroke on a vertical run. Horizontal text
%% sits on the stroke. Its white fill is only that label's own box.
\def\sysml@labelgap{0.6mm}
\def\sysml@labelsep{1.1pt}
\def\sysml@for#1\sysml@done{\def\sysml@iter{#1\relax\expandafter\sysml@iter\fi}\sysml@iter\let\sysml@iter\relax}
%% Rectangles already drawn: parts, port squares, port labels, other
%% text. A later label shifts along the path instead of covering them.
\newcommand{\sysml@pushabs}[5]{%
  \pgfmathsetmacro{\sysml@na}{#2}%
  \pgfmathsetmacro{\sysml@nb}{#3}%
  \pgfmathsetmacro{\sysml@nc}{#4}%
  \pgfmathsetmacro{\sysml@nd}{#5}%
  \ifdim\sysml@na pt>\sysml@nc pt
    \pgfmathsetmacro{\sysml@tmp}{\sysml@na}%
    \let\sysml@na\sysml@nc
    \let\sysml@nc\sysml@tmp
  \fi
  \ifdim\sysml@nb pt>\sysml@nd pt
    \pgfmathsetmacro{\sysml@tmp}{\sysml@nb}%
    \let\sysml@nb\sysml@nd
    \let\sysml@nd\sysml@tmp
  \fi
  \global\advance\sysml@obscount by 1\relax
  \expandafter\xdef\csname sysml@ok@\the\sysml@obscount\endcsname{#1}%
  \expandafter\xdef\csname sysml@osx@\the\sysml@obscount\endcsname{\sysml@na}%
  \expandafter\xdef\csname sysml@osy@\the\sysml@obscount\endcsname{\sysml@nb}%
  \expandafter\xdef\csname sysml@onx@\the\sysml@obscount\endcsname{\sysml@nc}%
  \expandafter\xdef\csname sysml@ony@\the\sysml@obscount\endcsname{\sysml@nd}%
  \ifsysml@marktrace
    \typeout{SYSMLBOX #1 \sysml@na\space\sysml@nb\space\sysml@nc\space\sysml@nd}%
  \fi
}
\newcommand{\sysml@recordxy}[5]{%
  \pgfpointtransformed{\pgfpointxy{#1}{#2}}%
  \edef\sysml@ax{\the\pgf@x}%
  \edef\sysml@ay{\the\pgf@y}%
  \pgfpointtransformed{\pgfpointxy{#1+#3}{#2+#4}}%
  \edef\sysml@bx{\the\pgf@x}%
  \edef\sysml@by{\the\pgf@y}%
  \sysml@pushabs{#5}{\sysml@ax}{\sysml@ay}{\sysml@bx}{\sysml@by}%
}
\newcommand{\sysml@pushnode}[2]{%
  \pgfpointtransformed{\pgfpointanchor{#2}{south west}}%
  \edef\sysml@ax{\the\pgf@x}%
  \edef\sysml@ay{\the\pgf@y}%
  \pgfpointtransformed{\pgfpointanchor{#2}{north east}}%
  \edef\sysml@bx{\the\pgf@x}%
  \edef\sysml@by{\the\pgf@y}%
  \sysml@pushabs{#1}{\sysml@ax}{\sysml@ay}{\sysml@bx}{\sysml@by}%
}
\newcommand{\sysml@measurepath}{%
  \gdef\sysml@totallen{0}%
  \ifnum\sysml@npt>1\relax
    \expandafter\gdef\csname sysml@cum@1\endcsname{0}%
    \sysml@oi=1\relax
    \loop
    \ifnum\sysml@oi<\sysml@npt
      \edef\sysml@next{\the\numexpr\sysml@oi+1\relax}%
      \pgfmathsetmacro{\sysml@seglen}{veclen(%
        \csname sysml@ax@\sysml@next\endcsname-\csname sysml@ax@\the\sysml@oi\endcsname,%
        \csname sysml@ay@\sysml@next\endcsname-\csname sysml@ay@\the\sysml@oi\endcsname)}%
      \pgfmathsetmacro{\sysml@tot}{\sysml@totallen+\sysml@seglen}%
      \xdef\sysml@totallen{\sysml@tot}%
      \expandafter\xdef\csname sysml@cum@\sysml@next\endcsname{\sysml@tot}%
      \expandafter\xdef\csname sysml@seg@\the\sysml@oi\endcsname{\sysml@seglen}%
      \advance\sysml@oi by 1\relax
    \repeat
  \fi
}
%% #1 is a written-path fraction. Sets px, py and phoriz (1 = horizontal).
\newcommand{\sysml@pointat}[1]{%
  \pgfmathsetmacro{\sysml@dist}{#1*\sysml@totallen}%
  \sysml@oi=1\relax
  \loop
  \ifnum\sysml@oi<\sysml@npt
    \edef\sysml@next{\the\numexpr\sysml@oi+1\relax}%
    \ifdim\sysml@dist pt>\csname sysml@cum@\sysml@next\endcsname pt
      \advance\sysml@oi by 1\relax
    \else
      \pgfmathsetmacro{\sysml@cbase}{\csname sysml@cum@\the\sysml@oi\endcsname}%
      \pgfmathsetmacro{\sysml@seglen}{\csname sysml@seg@\the\sysml@oi\endcsname}%
      \pgfmathsetmacro{\sysml@t}{\sysml@seglen>0.01 ? (\sysml@dist-\sysml@cbase)/\sysml@seglen : 0}%
      \pgfmathsetmacro{\sysml@px}{\csname sysml@ax@\the\sysml@oi\endcsname+\sysml@t*(\csname sysml@ax@\sysml@next\endcsname-\csname sysml@ax@\the\sysml@oi\endcsname)}%
      \pgfmathsetmacro{\sysml@py}{\csname sysml@ay@\the\sysml@oi\endcsname+\sysml@t*(\csname sysml@ay@\sysml@next\endcsname-\csname sysml@ay@\the\sysml@oi\endcsname)}%
      \pgfmathsetmacro{\sysml@pdx}{abs(\csname sysml@ax@\sysml@next\endcsname-\csname sysml@ax@\the\sysml@oi\endcsname)}%
      \pgfmathsetmacro{\sysml@pdy}{abs(\csname sysml@ay@\sysml@next\endcsname-\csname sysml@ay@\the\sysml@oi\endcsname)}%
      \ifdim\sysml@pdx pt<\sysml@pdy pt
        \def\sysml@phoriz{0}%
      \else
        \def\sysml@phoriz{1}%
      \fi
      \sysml@oi=\sysml@npt
    \fi
  \repeat
}
\newcommand{\sysml@measuretext}[1]{%
  \pgfinterruptpicture
    \setbox0=\hbox{\sysml@font{\sysml@body}#1}%
  \endpgfinterruptpicture
  \pgfmathsetmacro{\sysml@labwd}{\wd0+2*\sysml@labelsep}%
  \pgfmathsetmacro{\sysml@labht}{\ht0+\dp0+2*\sysml@labelsep}%
}
\newcommand{\sysml@candbox}{%
  \pgfmathsetmacro{\sysml@hw}{\sysml@labwd/2}%
  \pgfmathsetmacro{\sysml@hh}{\sysml@labht/2}%
  \ifsysml@centreonly
    \pgfmathsetmacro{\sysml@cx}{\sysml@px}%
    \pgfmathsetmacro{\sysml@cy}{\sysml@py}%
  \else
    \ifdim\sysml@phoriz pt>0pt
      \pgfmathsetmacro{\sysml@cx}{\sysml@px}%
      \pgfmathsetmacro{\sysml@cy}{\sysml@py}%
    \else
      \pgfmathsetmacro{\sysml@gappt}{0.6*72.27/25.4}%
      \pgfmathsetmacro{\sysml@cx}{\sysml@px+\sysml@gappt+\sysml@hw}%
      \pgfmathsetmacro{\sysml@cy}{\sysml@py}%
    \fi
  \fi
  \pgfmathsetmacro{\sysml@xlo}{\sysml@cx-\sysml@hw}%
  \pgfmathsetmacro{\sysml@ylo}{\sysml@cy-\sysml@hh}%
  \pgfmathsetmacro{\sysml@xhi}{\sysml@cx+\sysml@hw}%
  \pgfmathsetmacro{\sysml@yhi}{\sysml@cy+\sysml@hh}%
}
\newcommand{\sysml@markbox}{%
  \ifsysml@midmark
    \sysml@pointat{0.5}%
    \pgfmathsetmacro{\sysml@along}{2.0*72.27/25.4}%
    \pgfmathsetmacro{\sysml@across}{1.7*72.27/25.4}%
    \ifdim\sysml@phoriz pt>0pt
      \pgfmathsetmacro{\sysml@mxlo}{\sysml@px-\sysml@along}%
      \pgfmathsetmacro{\sysml@mxhi}{\sysml@px+\sysml@along}%
      \pgfmathsetmacro{\sysml@mylo}{\sysml@py-\sysml@across}%
      \pgfmathsetmacro{\sysml@myhi}{\sysml@py+\sysml@across}%
    \else
      \pgfmathsetmacro{\sysml@mxlo}{\sysml@px-\sysml@across}%
      \pgfmathsetmacro{\sysml@mxhi}{\sysml@px+\sysml@across}%
      \pgfmathsetmacro{\sysml@mylo}{\sysml@py-\sysml@along}%
      \pgfmathsetmacro{\sysml@myhi}{\sysml@py+\sysml@along}%
    \fi
  \fi
}
%% Overlap must be more than 0.4 pt on both axes. A shared edge is not a cover.
\newcommand{\sysml@hitsone}[4]{%
  \sysml@owa=\sysml@xhi pt\relax
  \ifdim#3pt<\sysml@owa \sysml@owa=#3pt\relax \fi
  \sysml@owb=\sysml@xlo pt\relax
  \ifdim#1pt>\sysml@owb \sysml@owb=#1pt\relax \fi
  \advance\sysml@owa by -\sysml@owb\relax
  \ifdim\sysml@owa>0.4pt
    \sysml@owa=\sysml@yhi pt\relax
    \ifdim#4pt<\sysml@owa \sysml@owa=#4pt\relax \fi
    \sysml@owb=\sysml@ylo pt\relax
    \ifdim#2pt>\sysml@owb \sysml@owb=#2pt\relax \fi
    \advance\sysml@owa by -\sysml@owb\relax
    \ifdim\sysml@owa>0.4pt
      \sysml@hittrue
    \fi
  \fi
}
\newcommand{\sysml@checkhits}{%
  \sysml@hitfalse
  \sysml@oi=0\relax
  \loop
  \ifnum\sysml@oi<\sysml@obscount
    \advance\sysml@oi by 1\relax
    \ifsysml@hit
    \else
      \sysml@hitsone
        {\csname sysml@osx@\the\sysml@oi\endcsname}%
        {\csname sysml@osy@\the\sysml@oi\endcsname}%
        {\csname sysml@onx@\the\sysml@oi\endcsname}%
        {\csname sysml@ony@\the\sysml@oi\endcsname}%
    \fi
  \repeat
  \ifsysml@midmark
    \ifsysml@hit
    \else
      \sysml@hitsone{\sysml@mxlo}{\sysml@mylo}{\sysml@mxhi}{\sysml@myhi}%
    \fi
  \fi
}
%% #1 is a fraction measured from the from end, not from the path start.
\newcommand{\sysml@tryfrom}[1]{%
  \ifsysml@accept
  \else
    \pgfmathsetmacro{\sysml@fromf}{#1}%
    \ifdim\sysml@fromf pt<\sysml@flo pt
    \else
      \ifdim\sysml@fromf pt>\sysml@fhi pt
      \else
        \ifsysml@alongpath
          \pgfmathsetmacro{\sysml@wf}{\sysml@fromf}%
        \else
          \pgfmathsetmacro{\sysml@wf}{1-\sysml@fromf}%
        \fi
        \sysml@pointat{\sysml@wf}%
        \sysml@candbox
        \sysml@checkhits
        \ifsysml@hit
        \else
          \sysml@accepttrue
          \xdef\sysml@frac{\sysml@wf}%
        \fi
      \fi
    \fi
  \fi
}
\newcommand{\sysml@choosefrac}[1]{%
  \sysml@measuretext{#1}%
  \ifsysml@midmark
    \def\sysml@flo{0.08}%
    \def\sysml@fhi{0.42}%
    \def\sysml@fideal{0.25}%
  \else
    \def\sysml@flo{0.08}%
    \def\sysml@fhi{0.92}%
    \def\sysml@fideal{0.5}%
  \fi
  \ifsysml@alongpath
    \xdef\sysml@frac{\sysml@fideal}%
  \else
    \pgfmathsetmacro{\sysml@wf}{1-\sysml@fideal}%
    \xdef\sysml@frac{\sysml@wf}%
  \fi
  \sysml@acceptfalse
  \ifnum\sysml@npt>1\relax
    \ifdim\sysml@totallen pt>1pt
      \sysml@markbox
      \pgfmathsetmacro{\sysml@step}{0.8*72.27/25.4/\sysml@totallen}%
      \sysml@tryfrom{\sysml@fideal}%
      \sysml@k=1\relax
      \sysml@for\ifnum\sysml@k<28
        \ifsysml@accept
        \else
          \sysml@tryfrom{\sysml@fideal-\the\sysml@k*\sysml@step}%
          \sysml@tryfrom{\sysml@fideal+\the\sysml@k*\sysml@step}%
        \fi
        \advance\sysml@k by 1\relax
      \sysml@done
    \fi
  \fi
}
%% Upright equals sign, centred on the mark. fill=white gaps the stroke.
%% The glyph is not rotated: a quarter turn would draw bars as ||.
\newcommand{\sysml@placeequals}{%
  \node[sysml edge label] (sysml@lab) at (0,0) {=};%
  \def\sysml@side{centre}%
  \def\sysml@fill{1}%
  \sysml@tracelabel{bind}%
  \sysml@pushnode{edge}{sysml@lab}%
}
%% Text stays upright. A horizontal segment keeps it on the line.
%% A vertical segment puts it to the right, with no fill.
\newcommand{\sysml@placetext}[2]{%
  \begingroup
    \pgfmathsetmacro{\sysml@c}{abs(cos(\pgfdecoratedangle))}%
    \pgfmathsetmacro{\sysml@s}{abs(sin(\pgfdecoratedangle))}%
    \ifsysml@centreonly
      \def\sysml@side{centre}%
      \def\sysml@fill{1}%
      \node[sysml edge label] (sysml@lab) at (0,0) {#2};%
    \else
      \ifdim\sysml@c pt<\sysml@s pt
        \def\sysml@side{right}%
        \def\sysml@fill{0}%
        \node[sysml edge text, anchor=west, xshift=\sysml@labelgap] (sysml@lab) at (0,0) {#2};%
      \else
        \def\sysml@side{inline}%
        \def\sysml@fill{1}%
        \node[sysml edge label] (sysml@lab) at (0,0) {#2};%
      \fi
    \fi
    \sysml@tracelabel{#1}%
    \sysml@pushnode{edge}{sysml@lab}%
  \endgroup
}
\newcommand{\sysml@tracelabel}[1]{%
  \ifsysml@marktrace
    \begingroup
      \pgfpointtransformed{\pgfpointorigin}%
      \edef\sysml@mx{\the\pgf@x}%
      \edef\sysml@my{\the\pgf@y}%
      \pgfpointtransformed{\pgfpointanchor{sysml@lab}{center}}%
      \edef\sysml@lx{\the\pgf@x}%
      \edef\sysml@ly{\the\pgf@y}%
      \pgfmathsetmacro{\sysml@mang}{\pgfdecoratedangle}%
      \typeout{SYSMLMARK #1 rot=0 side=\sysml@side\space x=\sysml@mx\space y=\sysml@my\space ang=\sysml@mang}%
      \typeout{SYSMLLAB #1 fill=\sysml@fill\space lx=\sysml@lx\space ly=\sysml@ly}%
    \endgroup
  \fi
}
\newcommand{\sysml@placetriangle}{%
  \ifsysml@usefwd
    \sysml@trace{triangle dir=fwd}%
    \arrow{Triangle[length=3.2mm,width=2.6mm,sep=0pt]}%
  \else
    \sysml@trace{triangle dir=rev}%
    \arrowreversed{Triangle[length=3.2mm,width=2.6mm,sep=0pt]}%
  \fi
}
\newcommand{\sysml@addlabel}[3]{%
  \sysml@addmark{#1}{\sysml@placetext{#2}{#3}}%
}
\newcommand{\sysml@addtriangle}{%
  \sysml@addmark{0.5}{\sysml@placetriangle}%
}
\newcommand{\sysml@queueitem}{%
  \pgfkeysgetvalue{/sysml/connection/item}{\sysml@item}%
  \ifx\sysml@item\@empty\else
    \sysml@choosefrac{\sysml@item}%
    \sysml@addlabel{\sysml@frac}{item}{\sysml@item}%
  \fi
}
%% Mid-line triangle at 0.5. Text, when present, sits at the middle of
%% the from-side half, and is queued in increasing written fraction.
\newcommand{\sysml@queuemid}{%
  \sysml@midmarktrue
  \pgfkeysgetvalue{/sysml/connection/item}{\sysml@item}%
  \ifx\sysml@item\@empty
    \sysml@addtriangle
  \else
    \sysml@choosefrac{\sysml@item}%
    \ifdim\sysml@frac pt<0.5pt
      \sysml@addlabel{\sysml@frac}{item}{\sysml@item}%
      \sysml@addtriangle
    \else
      \sysml@addtriangle
      \sysml@addlabel{\sysml@frac}{item}{\sysml@item}%
    \fi
  \fi
}
\newcommand{\sysml@drawmarked}[2]{%
  \path[decorate, decoration={markings, #1}] #2;%
}
\newcommand{\sysml@drawpath}[2]{%
  \ifsysml@marktrace
    \sysml@addmark{0.999}{\sysml@trace{end}}%
  \fi
  \draw[#1] #2;%
  \ifx\sysml@marks\@empty\else
    \expandafter\sysml@drawmarked\expandafter{\sysml@marks}{#2}%
  \fi
}
\newcommand{\sysml@drawitem}[2]{%
  \sysml@midmarkfalse
  \sysml@queueitem
  \sysml@drawpath{#1}{#2}%
}
\newcommand{\sysml@resetline}[1]{%
  \def\sysml@marks{}%
  \sysml@midmarkfalse
  \sysml@centreonlyfalse
  \pgfkeys{/sysml/connection, from={}, to={}, directed=false, flow={}, item={}, at=end, keyword=false, #1}%
  \sysml@loadends
  \sysml@warnends
}

%% #1 keys. #2 name, not drawn (names stay off the edge). #3 path.
%% A connection is a plain solid line. directed draws an open stick
%% at the to end. flow=forward|reverse draws a filled mid-line triangle.
\newcommand{\sysmlconnection}[3][]{%
  \sysml@resetline{#1}%
  \def\sysml@edgename{#2}%
  \sysml@pathendisto{#3}%
  \pgfkeysgetvalue{/sysml/connection/flow}{\sysml@flow}%
  \ifx\sysml@flow\@empty
    \ifsysml@directed
      \sysml@headstyle{sysml directed}%
    \else
      \def\sysml@drawstyle{sysml connection}%
    \fi
    \expandafter\sysml@drawitem\expandafter{\sysml@drawstyle}{#3}%
  \else
    \sysml@setpointatto
    \sysml@choosearrow
    \ifsysml@directed
      \sysml@headstyle{sysml directed}%
    \else
      \def\sysml@drawstyle{sysml connection}%
    \fi
    \sysml@queuemid
    \expandafter\sysml@drawpath\expandafter{\sysml@drawstyle}{#3}%
  \fi
}
%% Solid filled triangle from from toward to. at=mid keeps it on the line.
\newcommand{\sysmlflow}[3][]{%
  \sysml@resetline{#1}%
  \def\sysml@edgename{#2}%
  \sysml@pointattotrue
  \pgfkeysgetvalue{/sysml/connection/at}{\sysml@at}%
  \edef\sysml@attest{\sysml@at}%
  \def\sysml@midword{mid}%
  \sysml@pathendisto{#3}%
  \ifx\sysml@attest\sysml@midword
    \sysml@choosearrow
    \sysml@queuemid
    \sysml@drawpath{sysml connection}{#3}%
  \else
    \sysml@headstyle{sysml flow}%
    \expandafter\sysml@drawitem\expandafter{\sysml@drawstyle}{#3}%
  \fi
}
%% Dashed line, filled triangle at the to end.
\newcommand{\sysmlsuccessionflow}[3][]{%
  \sysml@resetline{#1}%
  \def\sysml@edgename{#2}%
  \sysml@pathendisto{#3}%
  \sysml@headstyle{sysml succession}%
  \expandafter\sysml@drawitem\expandafter{\sysml@drawstyle}{#3}%
}
%% Solid line, hollow triangle at the to end.
\newcommand{\sysmlmessage}[3][]{%
  \sysml@resetline{#1}%
  \def\sysml@edgename{#2}%
  \sysml@pathendisto{#3}%
  \sysml@headstyle{sysml message}%
  \expandafter\sysml@drawitem\expandafter{\sysml@drawstyle}{#3}%
}
%% Solid line, upright equals sign at the arc-length midpoint, no
%% arrowhead. The glyph is not rotated. The label fill gaps the stroke.
\newcommand{\sysmlbinding}[3][]{%
  \sysml@resetline{#1}%
  \def\sysml@edgename{#2}%
  \sysml@pathendisto{#3}%
  \sysml@centreonlytrue
  \sysml@choosefrac{=}%
  \sysml@centreonlyfalse
  \sysml@addmark{\sysml@frac}{\sysml@placeequals}%
  \sysml@drawpath{sysml connection}{#3}%
}
%% Solid line, optional «interface», no arrowhead.
\newcommand{\sysmlinterface}[3][]{%
  \def\sysml@marks{}%
  \pgfkeys{/sysml/connection, from={}, to={}, directed=false, flow={}, item={}, at=end, keyword=true, #1}%
  \def\sysml@edgename{#2}%
  \sysml@loadends
  \sysml@warnends
  \sysml@midmarkfalse
  \sysml@pathendisto{#3}%
  \ifsysml@showkeyword
    \sysml@choosefrac{\sysmlguillemets{interface}}%
    \sysml@addlabel{\sysml@frac}{interface}{\sysmlguillemets{interface}}%
  \fi
  \sysml@drawpath{sysml connection}{#3}%
}
%% Solid line, open stick at the to end (same head as directed), «allocate».
\newcommand{\sysmlallocation}[3][]{%
  \sysml@resetline{#1}%
  \def\sysml@edgename{#2}%
  \sysml@pathendisto{#3}%
  \sysml@headstyle{sysml allocate}%
  \sysml@midmarkfalse
  \sysml@choosefrac{\sysmlguillemets{allocate}}%
  \sysml@addlabel{\sysml@frac}{allocate}{\sysmlguillemets{allocate}}%
  \expandafter\sysml@drawpath\expandafter{\sysml@drawstyle}{#3}%
}

%% Collapse count, bottom-right inside the owner. Not a header line.
\newcommand{\sysmlbadge}[3]{%
  \node[sysml badge] at (#1,#2) {#3};%
}

\newcommand{\sysmlconnectionlegend}[1]{%
  \par\noindent{\fontsize{7}{9}\selectfont Connections: #1\par}%
}

\newcommand{\sysmlnotation}{%
  \par\noindent{\fontsize{7}{9}\selectfont n hidden = collapsed parts (not SysML notation)\par}%
}

\newcommand{\sysmlstamp}{%
  \par\noindent{\fontsize{7}{9}\selectfont
    View \texttt{\pgfkeysvalueof{/sysml/view}}\quad
    rev \texttt{\pgfkeysvalueof{/sysml/revision}}\quad
    overrides \texttt{\pgfkeysvalueof{/sysml/overrides}}\quad
    depth \texttt{\pgfkeysvalueof{/sysml/depth}}\par}%
}

\newcommand{\sysml@depthcutmessage}{%
  \begingroup
  \pgfkeysgetvalue{/sysml/depth cut}{\sysml@cut}%
  \ifx\sysml@cut\@empty
    Suggested depth cut: lower the document depth.%
  \else
    Suggested depth cut: \sysml@cut.%
  \fi
  \endgroup
}

\newsavebox{\sysmlpicbox}
\newsavebox{\sysmlcapbox}

\newcommand{\sysml@caption}{%
  \ifsysmlconnectionslist
    \pgfkeysgetvalue{/sysml/legend}{\sysml@leg}%
    \ifx\sysml@leg\@empty\else
      {\fontsize{7}{9}\selectfont Connections: \sysml@leg\par}%
    \fi
  \fi
  {\fontsize{7}{9}\selectfont
    View \texttt{\pgfkeysvalueof{/sysml/view}}\quad
    rev \texttt{\pgfkeysvalueof{/sysml/revision}}\quad
    overrides \texttt{\pgfkeysvalueof{/sysml/overrides}}\quad
    depth \texttt{\pgfkeysvalueof{/sysml/depth}}\quad
    type \texttt{\sysml@body}\,pt\par}%
}

\newcommand{\sysml@warntext}{%
  \par\noindent{\fontsize{7}{9}\selectfont
    Warning: this view does not fit the page at \sysml@body\,pt.
    The drawing was not scaled down.
    \sysml@depthcutmessage
    Each expanded part continues on its own page.\par}%
}

\newcommand{\sysml@footnote}{%
  \ifsysmlcollapsenote
    \par\vspace{2mm}%
    {\fontsize{7}{9}\selectfont n hidden = collapsed parts (not SysML notation)\par}%
  \fi
}

%% Caption is a wrapped paragraph inside the text block, then a 3 mm
%% gap, then the drawing. A picture with y down has a large TeX depth;
%% raising it by that depth keeps the following footnote below the frame.
%% Nothing is clipped. A fit warning is printed only when the generator
%% asks for one, which is the drill-down overview.
\newcommand{\sysml@typeset}{%
  \ifsysmlfitwarn
    \pgfkeysgetvalue{/sysml/depth cut}{\sysml@cut}%
    \ifx\sysml@cut\@empty
      \typeout{SYSMLDEPTHCUT lower the document depth}%
    \else
      \typeout{SYSMLDEPTHCUT \sysml@cut}%
    \fi
    \PackageWarning{sysml-tikz}{View does not fit the page at \sysml@body pt. Text was not shrunk. \sysml@depthcutmessage}%
  \fi
  \setbox\sysmlcapbox=\vbox{%
    \hsize=\textwidth
    \raggedright
    \noindent\sysml@caption
    \ifsysmlfitwarn\sysml@warntext\fi
  }%
  \noindent\usebox{\sysmlcapbox}\par
  \vspace{3mm}%
  \noindent\makebox[\textwidth][c]{\raisebox{\dp\sysmlpicbox}{\usebox{\sysmlpicbox}}}\par
  \sysml@footnote
}

%% Body is a sysmlcanvas (or other horizontal material) plus nothing else.
%% lrbox is begun with \begin so it restores \@currenvir before the body.
\newenvironment{sysmlfigure}[1][]{%
  \sysmlset{#1}%
  \begin{lrbox}{\sysmlpicbox}%
}{%
  \end{lrbox}%
  \sysml@typeset
}

%% ELK y-down millimetre coordinates. No placement.
\newenvironment{sysmlcanvas}{%
  \tikzpicture[x=1mm,y=-1mm]%
  \global\sysml@obscount=0\relax
  \ifsysml@marktrace
    \pgfpointtransformed{\pgfpointorigin}%
    \typeout{SYSMLORIGIN x=\the\pgf@x\space y=\the\pgf@y}%
  \fi
}{%
  \endtikzpicture
}
